generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  REVIEWER
  ORGANIZER
  ADMIN
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  roles        Role[]   @default([PARTICIPANT])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  address         Address?
  organizedEvents Event[]
  submissions     Submission[]
  coauthorships   SubmissionCoauthor[]
  reviews         Review[]

  @@map("users")
}

model Address {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @unique @map("user_id") @db.Uuid
  cep          String  @db.VarChar(8)
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String  @db.Char(2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Event {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  areas              String[]
  organizerId        String    @map("organizer_id") @db.Uuid
  submissionStartsAt DateTime  @map("submission_starts_at")
  submissionEndsAt   DateTime  @map("submission_ends_at")
  reviewStartsAt     DateTime  @map("review_starts_at")
  reviewEndsAt       DateTime  @map("review_ends_at")
  resultAt           DateTime  @map("result_at")
  approvalThreshold  Decimal   @default(6) @map("approval_threshold") @db.Decimal(4, 2)
  resultsPublishedAt DateTime? @map("results_published_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organizer   User         @relation(fields: [organizerId], references: [id])
  submissions Submission[]

  @@map("events")
}

model Submission {
  id         String           @id @default(uuid()) @db.Uuid
  eventId    String           @map("event_id") @db.Uuid
  authorId   String           @map("author_id") @db.Uuid
  title      String
  abstract   String?
  area       String
  status     SubmissionStatus @default(SUBMITTED)
  fileKey    String           @map("file_key")
  fileName   String           @map("file_name")
  fileSize   Int              @map("file_size")
  finalGrade Decimal?         @map("final_grade") @db.Decimal(4, 2)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  event       Event                @relation(fields: [eventId], references: [id])
  author      User                 @relation(fields: [authorId], references: [id])
  coauthors   SubmissionCoauthor[]
  reviews     Review[]
  certificate Certificate?

  @@index([eventId, status])
  @@index([authorId])
  @@map("submissions")
}

/// Coautor identificado pelo e-mail; se já tiver conta, fica vinculado (userId)
model SubmissionCoauthor {
  id           String  @id @default(uuid()) @db.Uuid
  submissionId String  @map("submission_id") @db.Uuid
  name         String
  email        String
  userId       String? @map("user_id") @db.Uuid

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id])

  @@unique([submissionId, email])
  @@index([email])
  @@map("submission_coauthors")
}

/// Atribuição de avaliador + avaliação (grade/comments preenchidos quando submittedAt != null)
model Review {
  id           String    @id @default(uuid()) @db.Uuid
  submissionId String    @map("submission_id") @db.Uuid
  reviewerId   String    @map("reviewer_id") @db.Uuid
  grade        Decimal?  @db.Decimal(4, 2)
  comments     String?
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  submittedAt  DateTime? @map("submitted_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id])

  @@unique([submissionId, reviewerId])
  @@index([reviewerId])
  @@map("reviews")
}

/// Falhas de login por e-mail (existente ou não); a linha é apagada no login bem-sucedido
model LoginAttempt {
  email          String    @id
  failures       Int       @default(0)
  windowStartsAt DateTime  @default(now()) @map("window_starts_at")
  lockedUntil    DateTime? @map("locked_until")

  @@map("login_attempts")
}

/// Tokens revogados no logout; a linha pode ser apagada depois que o token expira
model RevokedToken {
  jti       String   @id
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model Certificate {
  id               String   @id @default(uuid()) @db.Uuid
  submissionId     String   @unique @map("submission_id") @db.Uuid
  storageKey       String   @map("storage_key")
  verificationCode String   @unique @map("verification_code")
  issuedAt         DateTime @default(now()) @map("issued_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("certificates")
}
