NODE_ENV=development
PORT=3333
APP_PUBLIC_URL=http://localhost:3333
LOG_LEVEL=info

# Postgres: tabelas da aplicação + schema "pgboss" (fila de jobs) no MESMO banco
DATABASE_URL=postgresql://grande:grande@localhost:5432/grande?schema=public
PGBOSS_SCHEMA=pgboss

JWT_SECRET=troque-este-segredo-por-um-valor-com-32-ou-mais-caracteres
JWT_EXPIRES_IN=1d

# Upload
MAX_UPLOAD_MB=10

# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=grande
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# E-mail: log | smtp (MailHog: SMTP em localhost:1025, UI em http://localhost:8025)
MAIL_DRIVER=log
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Grande <nao-responda@grande.local>"

# ViaCEP
VIACEP_BASE_URL=https://viacep.com.br/ws
VIACEP_TIMEOUT_MS=3000
VIACEP_RETRIES=2
VIACEP_CACHE_TTL_SECONDS=86400
